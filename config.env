# Benchmark configuration. Copy to config.local.env to override values;
# config.local.env is sourced after this file and is git-ignored.

# ---- Model under test -------------------------------------------------------
MODEL_NAME="Qwen3.8-27B"
# GGUF models (llama.cpp): one per line, "label  repo  file-pattern". The pattern is
# a glob matched against the repo's files (also used for download). bootstrap.sh
# downloads all of them; each ./run.sh pass benchmarks ONE model (the first line by
# default, or MODEL=<label>). Compare passes with ./run.sh compare <run> <run>...
#   gsq-iq3s-mtp  ~12 GB  ISTA-DASLab GSQ+RCO non-uniform 3.5 bpw, MTP head included
#   q8_0          ~29 GB  standard Q8_0 (no official Qwen GGUF found; unsloth's plain
#                         Q8_0, not their UD mixed-precision variant)
GGUF_MODELS="
gsq-iq3s-mtp  ISTA-DASLab/Qwen3.8-27B-GSQ-RCO-GGUF  Qwen3.8-27B-GSQ-RCO-IQ3_S-mtp.gguf
q8_0          unsloth/Qwen3.8-27B-GGUF              *-Q8_0.gguf
"

# Original repo; only its tokenizer files are downloaded (used by llama-benchy).
TOKENIZER_REPO="Qwen/Qwen3.8-27B"
# MLX build (optional engine comparison). Leave empty to skip MLX.
MLX_REPO="mlx-community/Qwen3.8-27B-4bit"

# ---- llama.cpp --------------------------------------------------------------
# A tag such as b7000, or "master". The exact commit is recorded with results.
# Qwen3.8 MTP speculative decoding needs a build from mid-2026 or later.
LLAMA_CPP_REF="master"
# Context window for the server (tokens). 131072 fits Q4 + q8_0 KV in 64 GB.
SERVER_CTX=131072
KV_CACHE_TYPE="q8_0"
# Use the MTP head (speculative decoding) when a model's GGUF has one and the
# llama.cpp build supports it. The server suite measures each model both ways;
# coding and agent suites use MTP when available (faster, same output distribution).
USE_MTP=1
MTP_DRAFT_N=2

# ---- Suites -------------------------------------------------------------------
# llama-bench: standard pp512/tg128 plus a context-depth sweep (-d).
BENCH_REPS=5
BENCH_DEPTHS="0,4096,16384,32768,65536"
# Server suite: llama-benchy (llama-bench style pp/tg at depth over the API,
# TTFT, concurrency, prefix caching) plus bench/server_bench.py (ITL percentiles).
# Prompt text for llama-benchy (the default Gutenberg path it uses can return an
# empty body). Fetched and checked by run.sh, then served from llama-benchy's cache.
BENCHY_BOOK_URL="https://www.gutenberg.org/cache/epub/1661/pg1661.txt"
BENCHY_PP="512 2048"
BENCHY_TG=128
BENCHY_DEPTHS="0 4096 16384 32768 65536"
LATENCY_REPS=3
CONCURRENCY_LEVELS="1 2 4"

# Coding: EvalPlus datasets (humaneval, mbpp).
EVALPLUS_DATASETS="humaneval"
# Qwen3.8 thinking mode for coding benchmarks (0 = off, much faster).
EVALPLUS_THINKING=0

# Agentic: SWE-bench via mini-swe-agent.
#   smoke    -> 1 instance (simple fix-a-bug task, ~10-30 min)
#   mini     -> SWE-bench Verified Mini, 50 instances (overnight)
#   verified -> SWE-bench Verified, 500 instances (several days)
SWE_SUBSET="mini"
# Optional slice of the subset, e.g. "0:10" for the first 10 tasks (mini/verified).
# With thinking on, expect roughly 1 h per task on this machine.
SWE_SLICE=""
SWE_SMOKE_INSTANCE="sympy__sympy-15599"
SWE_STEP_LIMIT=100
SWE_WORKERS=1
AGENT_THINKING=1
# Per-call output cap for the agent (thinking + answer) and the client timeout.
# Without a cap a single thinking step can run for many minutes and time out.
AGENT_MAX_TOKENS=16384
AGENT_TIMEOUT_S=3600
# Evaluation: "local" (swebench harness in Docker) or "sbcli" (SWE-bench cloud
# evaluator; needs SWEBENCH_API_KEY). "none" only produces predictions.
SWE_EVAL="local"

# ---- Power ------------------------------------------------------------------
# 1 = sample `sudo powermetrics` during llama-bench and server runs (asks for sudo).
MEASURE_POWER=0

# ---- Llama-2 7B reference run for llama.cpp Discussion #4167 -----------------
# 1 = bootstrap downloads the models for ./run.sh ref4167 (the exact command from the
# Apple Silicon thread, ~24 GB).
RUN_4167_REFERENCE=1
# The thread's reference numbers use this llama.cpp commit; bootstrap builds llama-bench
# at it in vendor/llama.cpp-4167 (separate from the main build). Empty = use the main build.
REF4167_LLAMA_REF="c1d0e7a00"

# ---- Ports ------------------------------------------------------------------
SERVER_PORT=8080
PROXY_PORT=8081
MLX_PORT=8090
