# vLLM (vllm-metal) settings. Sourced by vllm/bootstrap.sh and vllm/run.sh after the
# repo's config.env, so MODEL_NAME, BENCH_DEPTHS, BENCHY_*, LATENCY_REPS, EVALPLUS_*,
# SWE_* and MEASURE_POWER are shared with the llama.cpp harness. config.local.env is
# sourced again afterwards, so overrides for either harness go there.

# ---- Engine -------------------------------------------------------------------
# vllm-metal release and the vLLM core release it was cut against (the plugin's
# .github/vllm-release-tag.commit at that tag). Both wheels come from GitHub releases;
# versions are recorded with results.
VLLM_METAL_VERSION="0.31.0"
VLLM_VERSION="0.31.0"

# ---- Models under test --------------------------------------------------------
# One per line, "label  repo". vllm-metal runs Qwen3.8 (hybrid attention + GDN linear
# layers) through mlx_lm, so these are MLX checkpoints: its GGUF loader takes dense
# Qwen2/Qwen3/Llama/Mistral only, and no IQ quants, so the llama.cpp GGUFs can't be reused.
#   mlx-4bit  ~15 GB  closest to the 12 GB IQ3_S-mtp build on the llama.cpp side
#   mlx-8bit  ~29 GB  counterpart of Q8_0
VLLM_MODELS="
mlx-4bit  mlx-community/Qwen3.8-27B-4bit
mlx-8bit  mlx-community/Qwen3.8-27B-8bit
"
# Muse Glimmer 30B (Meta, dense, Apache 2.0) is NOT in vllm-metal's supported-model
# list yet; its model layers come from mlx_lm, so it loads only if mlx_lm knows the
# architecture. To try it, set in config.local.env:
#   MODEL_NAME="Muse-Glimmer-30B"
#   VLLM_MODELS="glimmer-q4k  RadixArk/Muse-Glimmer-q4k-dynamic-MLX"
#   VLLM_CHAT_KWARGS='{}'          # Qwen's enable_thinking switch does not apply

# ---- Server -------------------------------------------------------------------
# Same 128k window as llama-server. Hybrid models keep KV only for the full-attention
# layers, so this is cheap; --gpu-memory-utilization caps the (lazily committed) pool.
VLLM_MAX_MODEL_LEN=131072
VLLM_GPU_MEM_UTIL=0.75
# Prefill chunk. vllm-metal's recipes use 1024-2048 for 27B on 32-64 GB Macs; above 4096
# the plugin stops raising MLX_MAX_MB_PER_BUFFER.
VLLM_MAX_BATCHED_TOKENS=2048
# KV cache dtype ("auto" = model dtype). llama.cpp runs use q8_0 KV; note the difference
# when comparing engines.
VLLM_KV_CACHE_DTYPE="auto"
# Default chat-template kwargs for every request (thinking off, as llama.cpp's
# --chat-template-kwargs). Requests that set their own (EvalPlus, agent) still win.
VLLM_CHAT_KWARGS='{"enable_thinking": false}'
VLLM_REASONING_PARSER="qwen3"

# ---- Speculative decoding ------------------------------------------------------
# vllm-metal supports MTP only for Gemma 4 and rejects MTP/draft models on hybrid GDN
# targets such as Qwen3.8; n-gram is the one method it allows there. It drafts only
# greedy requests (temperature 0), forces synchronous scheduling and needs FP32 GDN state.
# 1 = measure each model with and without n-gram speculation in the server suite.
USE_NGRAM=1
NGRAM_SPEC_CONFIG='{"method":"ngram","num_speculative_tokens":3,"prompt_lookup_min":2,"prompt_lookup_max":3}'

# ---- Suites -------------------------------------------------------------------
# perf: `vllm bench serve` single-request sweep (the llama-bench analogue): a prompt of
# depth+VLLM_PP tokens and VLLM_TG output tokens per depth in BENCH_DEPTHS.
VLLM_PP=512
VLLM_TG=128
# Throughput sweep (batching is what vLLM adds over llama.cpp): random prompts of
# VLLM_SWEEP_IN tokens, VLLM_SWEEP_OUT outputs, at each concurrency level.
VLLM_CONCURRENCY_LEVELS="1 2 4 8"
VLLM_SWEEP_IN=1024
VLLM_SWEEP_OUT=256

VLLM_PORT=8000
